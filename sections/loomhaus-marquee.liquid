
{{ 'loomhaus-marquee.css' | asset_url | stylesheet_tag }}

<section
  class="loomhaus-marquee"
  id="LoomhausMarquee-{{ section.id }}"
  style="
    --marquee-background: {{ section.settings.background_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-speed: {{ section.settings.speed }}s;
  "
>
  <div class="loomhaus-marquee__viewport">
    <div class="loomhaus-marquee__track">

      {% for repeat in (1..2) %}
        <div
          class="loomhaus-marquee__group"
          {% if repeat == 2 %}aria-hidden="true"{% endif %}
        >
          {% for block in section.blocks %}
            <div
              class="loomhaus-marquee__item"
              {% if repeat == 1 %}
                {{ block.shopify_attributes }}
              {% endif %}
            >
              <span class="loomhaus-marquee__text">
                {{ block.settings.text | escape }}
              </span>

              {% if section.settings.show_separator %}
                <span class="loomhaus-marquee__separator" aria-hidden="true">
                  ✦
                </span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loomhaus marquee",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#777A67"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scrolling speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show star separator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Organic cotton"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Loomhaus marquee",
      "blocks": [
        {
          "type": "marquee_item",
          "settings": {
            "text": "Organic cotton"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "text": "Made to last"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "text": "Sizes XS to L"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "text": "Free returns"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "text": "Ethically made"
          }
        }
      ]
    }
  ]
}
{% endschema %}
