{{ 'loomhaus-featured-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'loomhaus-featured-product.js' | asset_url }}" defer="defer"></script>

{% assign featured_product = section.settings.product %}

{% if featured_product != blank %}
  {% assign current_variant = featured_product.selected_or_first_available_variant %}
  {% assign badge = featured_product.metafields.custom.badge.value %}
  {% assign rating = featured_product.metafields.custom.rating.value %}
  {% assign review_count = featured_product.metafields.custom.review_count.value %}
  {% assign highlight_title = featured_product.metafields.custom.highlight_title.value %}
  {% assign highlight_text = featured_product.metafields.custom.highlight_text.value %}
  {% assign size_ribbon = featured_product.metafields.custom.size_ribbon.value %}
  {% assign offer_code_1 = featured_product.metafields.custom.offer_code_1.value %}
  {% assign offer_code_2 = featured_product.metafields.custom.offer_code_2.value %}
  {% assign offer_discount_1 = featured_product.metafields.custom.offer_discount_1.value | default: 10 %}
  {% assign offer_discount_2 = featured_product.metafields.custom.offer_discount_2.value | default: 15 %}

  {% assign savings_percent = 0 %}
  {% if current_variant.compare_at_price > current_variant.price %}
    {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
    {% assign savings_percent = savings | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
  {% endif %}

  <section
    id="LoomhausFeatured-{{ section.id }}"
    class="loomhaus-featured"
    data-featured-product
    data-section-id="{{ section.id }}"
data-initial-variant="{{ current_variant.id }}"
data-offer-discount-one="{{ offer_discount_1 }}"
data-offer-discount-two="{{ offer_discount_2 }}"
  >
    <script type="application/json" data-featured-product-json>
      {{ featured_product | json }}
    </script>

    <div class="loomhaus-featured__container">

      <!-- Product gallery -->
      <div class="loomhaus-featured__gallery">
        <div class="loomhaus-featured__main-image">
          {% if featured_product.featured_image %}
            {{
              featured_product.featured_image
              | image_url: width: 1400
              | image_tag:
                class: 'loomhaus-featured__image',
                loading: 'lazy',
                alt: featured_product.featured_image.alt
            }}
          {% endif %}

          <button
            type="button"
            class="loomhaus-featured__arrow loomhaus-featured__arrow--prev"
            data-gallery-prev
            aria-label="Previous image"
          >‹</button>

          <button
            type="button"
            class="loomhaus-featured__arrow loomhaus-featured__arrow--next"
            data-gallery-next
            aria-label="Next image"
          >›</button>
        </div>

        <div class="loomhaus-featured__thumbnails" data-gallery-thumbnails>
          {% for image in featured_product.images %}
            <button
              type="button"
              class="loomhaus-featured__thumbnail{% if forloop.first %} is-active{% endif %}"
              data-thumbnail
              data-image-index="{{ forloop.index0 }}"
              aria-label="View product image {{ forloop.index }}"
            >
              {{
                image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  alt: image.alt
              }}
            </button>
          {% endfor %}
        </div>
      </div>

      <!-- Product information -->
      <div class="loomhaus-featured__details">

        <div class="loomhaus-featured__topline">
          {% if badge != blank %}
            <span class="loomhaus-featured__badge">{{ badge | escape }}</span>
          {% endif %}

          {% if rating != blank %}
            <span class="loomhaus-featured__rating">
              <span aria-hidden="true">★</span>
              {{ rating }}
              {% if review_count != blank %}
                <span>({{ review_count }} Reviews)</span>
              {% endif %}
            </span>
          {% endif %}
        </div>

        <h2 class="loomhaus-featured__title">
          {{ featured_product.title | escape }}
        </h2>

        <!-- Price -->
        <div class="loomhaus-featured__price-row">
          <span class="loomhaus-featured__price" data-featured-price>
            {{ current_variant.price | money }}
          </span>

          <s
            class="loomhaus-featured__compare-price"
            data-featured-compare
            {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
          >
            {{ current_variant.compare_at_price | money }}
          </s>

          <span
            class="loomhaus-featured__save"
            data-featured-save
            {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
          >
            SAVE {{ savings_percent }}%
          </span>
        </div>

        <p class="loomhaus-featured__tax-note">
          MRP inclusive of all taxes
        </p>

        <!-- Highlight -->
        {% if highlight_title != blank or highlight_text != blank %}
          <div class="loomhaus-featured__highlight">
            <span class="loomhaus-featured__highlight-icon" aria-hidden="true">✓</span>
            <div>
              {% if highlight_title != blank %}
                <strong>{{ highlight_title | escape }}</strong>
              {% endif %}
              {% if highlight_text != blank %}
                <p>{{ highlight_text | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <!-- Variant options -->
        <div class="loomhaus-featured__options" data-featured-options>
          {% for option in featured_product.options_with_values %}
            {% assign option_name_downcase = option.name | downcase %}

            <fieldset
              class="loomhaus-featured__option"
              data-option-index="{{ forloop.index0 }}"
              data-option-name="{{ option.name | escape }}"
            >
              <legend class="loomhaus-featured__option-label">
                {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                  COLOR: <span data-selected-option>{{ current_variant.options[forloop.index0] }}</span>
                {% else %}
                  {{ option.name | upcase }}
                {% endif %}
              </legend>

              <div class="loomhaus-featured__option-values">
                {% for value in option.values %}
                  {% assign value_downcase = value | downcase %}
                  {% assign is_color_option = false %}
                  {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                    {% assign is_color_option = true %}
                  {% endif %}

                  <button
                    type="button"
                    class="
                      loomhaus-featured__value
                      {% if is_color_option %}loomhaus-featured__value--color{% endif %}
                      {% if current_variant.options[forloop.parentloop.index0] == value %}is-selected{% endif %}
                    "
                    data-option-value="{{ value | escape }}"
                    aria-pressed="{% if current_variant.options[forloop.parentloop.index0] == value %}true{% else %}false{% endif %}"
                  >
                    {% if is_color_option %}
                      <span
                        class="loomhaus-featured__swatch"
                        style="--swatch-color:
                          {% case value_downcase %}
                            {% when 'black' %}#222222
                            {% when 'white' %}#ffffff
                            {% when 'navy' %}#17263f
                            {% when 'blue' %}#315b91
                            {% when 'red' %}#b52e35
                            {% when 'green' %}#526b50
                            {% when 'olive' %}#77764b
                            {% when 'brown' %}#79533b
                            {% when 'grey' %}#999999
                            {% when 'gray' %}#999999
                            {% else %}{{ value | downcase }}
                          {% endcase %}
                        "
                      ></span>
                      <span>{{ value | escape }}</span>
                    {% else %}
                      {{ value | escape }}
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>

        <!-- Size ribbon -->
        {% if size_ribbon != blank %}
          <p class="loomhaus-featured__ribbon">{{ size_ribbon | escape }}</p>
        {% endif %}

        <!-- Quantity and Add to cart -->
        <div class="loomhaus-featured__purchase-row">
          <div class="loomhaus-featured__quantity" aria-label="Quantity selector">
            <button type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
            <input
              type="number"
              value="1"
              min="1"
              name="quantity"
              data-quantity-input
              aria-label="Quantity"
            >
            <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>

          <button
            type="button"
            class="loomhaus-featured__add"
            data-featured-add
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-featured-add-text>
              {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
            </span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <button
          type="button"
          class="loomhaus-featured__buy"
          data-featured-buy
          {% unless current_variant.available %}disabled{% endunless %}
        >
          BUY IT NOW
        </button>

        <!-- Offer cards -->
        {% if offer_code_1 != blank or offer_code_2 != blank %}
          <div class="loomhaus-featured__offers">
            {% if offer_code_1 != blank %}
              <div class="loomhaus-featured__offer">
                <div>
                  <strong data-offer-price-one>
                    Get it for {{ current_variant.price | money }}
                  </strong>
                  <p>Use code {{ offer_code_1 | escape }} for {{ offer_discount_1 }}% off</p>
                </div>
                <button type="button" data-copy-code="{{ offer_code_1 | escape }}" aria-label="Copy offer code">
                  ▢
                </button>
              </div>
            {% endif %}

            {% if offer_code_2 != blank %}
              <div class="loomhaus-featured__offer">
                <div>
                  <strong data-offer-price-two>Get it for {{ current_variant.price | money }}</strong>
                  <p>Buy 2, use code {{ offer_code_2 | escape }} for {{ offer_discount_2 }}% off</p>
                </div>
                <button type="button" data-copy-code="{{ offer_code_2 | escape }}" aria-label="Copy offer code">
                  ▢
                </button>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <p class="loomhaus-featured__message" data-featured-message aria-live="polite"></p>

      </div>
    </div>
  </section>

{% else %}
  <div class="loomhaus-featured__empty">
    Select a product in the Featured Product section settings.
  </div>
{% endif %}

{% schema %}
{
  "name": "Loomhaus featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    }
  ],
  "presets": [
    {
      "name": "Loomhaus featured product"
    }
  ]
}
{% endschema %}