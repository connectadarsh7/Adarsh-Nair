
{{ 'loomhaus-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'loomhaus-product-grid.js' | asset_url }}" defer="defer"></script>

<section
  class="loomhaus-lookbook"
  id="LoomhausLookbook-{{ section.id }}"
>
  <div class="loomhaus-lookbook__container">

    <!-- Heading row -->
    <div class="loomhaus-lookbook__header">
      <div class="loomhaus-lookbook__heading">
        {% if section.settings.eyebrow != blank %}
          <span class="loomhaus-lookbook__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}

        <h2>{{ section.settings.heading | escape }}</h2>
      </div>

      {% if section.settings.helper_text != blank %}
        <p class="loomhaus-lookbook__helper">
          {{ section.settings.helper_text | escape }}
        </p>
      {% endif %}
    </div>

    <!-- Product grid -->
    <div class="loomhaus-lookbook__grid">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <div
            class="loomhaus-lookbook__tile"
            {{ block.shopify_attributes }}
          >
            <a
              class="loomhaus-lookbook__image-link"
              href="{{ product.url }}"
              aria-label="{{ product.title | escape }}"
            >
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'loomhaus-lookbook__image',
                    loading: 'lazy',
                    alt: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'loomhaus-lookbook__placeholder' }}
              {% endif %}
            </a>

            <!-- Hotspot -->
            <button
              type="button"
              class="loomhaus-lookbook__hotspot"
              style="
                --hotspot-x: {{ block.settings.hotspot_x }}%;
                --hotspot-y: {{ block.settings.hotspot_y }}%;
              "
              aria-label="Quick view {{ product.title | escape }}"
              data-quick-view
              data-product-url="{{ product.url }}"
            >
              <span aria-hidden="true">+</span>
            </button>

            <!-- Product label -->
            <a
              href="{{ product.url }}"
              class="loomhaus-lookbook__label"
            >
              <span class="loomhaus-lookbook__product-title">
                {{ product.title | escape }}
              </span>

              <span class="loomhaus-lookbook__product-price">
                {{ product.price | money }}
              </span>
            </a>
          </div>

        {% else %}
          <div class="loomhaus-lookbook__tile loomhaus-lookbook__empty">
            {{ 'product-1' | placeholder_svg_tag: 'loomhaus-lookbook__placeholder' }}
            <span>Select a product in the theme editor</span>
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>

  <!-- Quick view modal -->
  <div
    class="loomhaus-quick-view"
    data-quick-view-modal
    aria-hidden="true"
  >
    <div class="loomhaus-quick-view__overlay" data-quick-view-close></div>

    <div
      class="loomhaus-quick-view__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Product quick view"
    >
      <button
        type="button"
        class="loomhaus-quick-view__close"
        data-quick-view-close
        aria-label="Close quick view"
      >
        &times;
      </button>

      <div class="loomhaus-quick-view__content">
        <div class="loomhaus-quick-view__image-wrap">
          <img
            src=""
            alt=""
            class="loomhaus-quick-view__image"
            data-quick-image
          >
        </div>

        <div class="loomhaus-quick-view__details">
          <span class="loomhaus-quick-view__eyebrow">QUICK VIEW</span>

          <h2 data-quick-title></h2>

          <p class="loomhaus-quick-view__price" data-quick-price></p>

          <p class="loomhaus-quick-view__description" data-quick-description></p>

          <label for="LoomhausQuickVariant-{{ section.id }}">
            Select option
          </label>

          <select
            id="LoomhausQuickVariant-{{ section.id }}"
            data-quick-variant
          ></select>

          <button
            type="button"
            class="loomhaus-quick-view__add"
            data-quick-add
          >
            ADD TO CART
          </button>

          <a
            href="#"
            class="loomhaus-quick-view__view-product"
            data-quick-product-link
          >
            View full product
          </a>

          <p class="loomhaus-quick-view__message" data-quick-message></p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loomhaus product grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Loomhaus in the wild"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Tap the + on any look to shop it."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Product tile",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus product grid",
      "blocks": [
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}
