{{ 'custom-announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-announcement-bar.js' | asset_url }}" defer="defer"></script>

<div class="loomhaus-announcement" data-announcement-section="{{ section.id }}">
  <div class="loomhaus-announcement__desktop">
    {% for block in section.blocks %}
      <div class="loomhaus-announcement__desktop-message" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text | escape }}
          </a>
        {% else %}
          {{ block.settings.text | escape }}
        {% endif %}
      </div>

      {% unless forloop.last %}
        <span class="loomhaus-announcement__separator" aria-hidden="true">✦</span>
      {% endunless %}
    {% endfor %}
  </div>

  <div class="loomhaus-announcement__mobile" aria-live="polite" aria-atomic="true">
    {% for block in section.blocks %}
      <div
        class="loomhaus-announcement__mobile-message{% if forloop.first %} is-active{% endif %}"
        data-announcement-slide
        {% unless forloop.first %}aria-hidden="true"{% endunless %}
      >
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text | escape }}
          </a>
        {% else %}
          {{ block.settings.text | escape }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Loomhaus announcement",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Free shipping on orders over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Announcement link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus announcement",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over ₹999"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Use code LOOM10 for 10% off your first order"
          }
        }
      ]
    }
  ]
}
{% endschema %}