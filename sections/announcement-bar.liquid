{{ 'custom-announcement-bar.css' | asset_url | stylesheet_tag }}

<div class="loomhaus-announcement" role="region" aria-label="Store announcements">
  <div class="loomhaus-announcement__inner">

    <p class="loomhaus-announcement__message">
      {% if section.settings.message_one_link != blank %}
        <a href="{{ section.settings.message_one_link }}">
          {{ section.settings.message_one | escape }}
        </a>
      {% else %}
        {{ section.settings.message_one | escape }}
      {% endif %}
    </p>

    <span class="loomhaus-announcement__separator" aria-hidden="true">✳</span>

    <p class="loomhaus-announcement__message">
      {% if section.settings.message_two_link != blank %}
        <a href="{{ section.settings.message_two_link }}">
          {{ section.settings.message_two | escape }}
        </a>
      {% else %}
        {{ section.settings.message_two | escape }}
      {% endif %}
    </p>

  </div>
</div>

{% schema %}
{
  "name": "Loomhaus announcement",
  "settings": [
    {
      "type": "text",
      "id": "message_one",
      "label": "First announcement",
      "default": "Free shipping on orders over ₹999"
    },
    {
      "type": "url",
      "id": "message_one_link",
      "label": "First announcement link"
    },
    {
      "type": "text",
      "id": "message_two",
      "label": "Second announcement",
      "default": "Use code LOOM10 for 10% off your first order"
    },
    {
      "type": "url",
      "id": "message_two_link",
      "label": "Second announcement link"
    }
  ],
  "presets": [
    {
      "name": "Loomhaus announcement"
    }
  ]
}
{% endschema %}