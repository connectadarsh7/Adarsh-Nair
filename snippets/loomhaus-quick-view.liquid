
{{ 'loomhaus-quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'loomhaus-product-grid.js' | asset_url }}" defer="defer"></script>

<div
  class="loomhaus-quick-view"
  data-quick-view-modal
  aria-hidden="true"
>
  <div
    class="loomhaus-quick-view__overlay"
    data-quick-view-close
  ></div>

  <div
    class="loomhaus-quick-view__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Product quick view"
    tabindex="-1"
  >
    <button
      type="button"
      class="loomhaus-quick-view__close"
      data-quick-view-close
      aria-label="Close quick view"
    >
      &times;
    </button>

    <div class="loomhaus-quick-view__content">

      <!-- Product image -->
      <div class="loomhaus-quick-view__image-wrap">
        <img
          src=""
          alt=""
          class="loomhaus-quick-view__image"
          data-quick-image
        >
      </div>

      <!-- Product details -->
      <div class="loomhaus-quick-view__details">

        <div class="loomhaus-quick-view__product-heading">
          <div>
            <h2 data-quick-title></h2>
            <p
              class="loomhaus-quick-view__price"
              data-quick-price
            ></p>
          </div>
        </div>

        <!-- Description -->
        <p
          class="loomhaus-quick-view__description"
          data-quick-description
        ></p>

        <!-- Colour options -->
        <div
          class="loomhaus-quick-view__option-group"
          data-color-group
          hidden
        >
          <label class="loomhaus-quick-view__option-label">
            COLOR
          </label>

          <div
            class="loomhaus-quick-view__colors"
            data-color-options
          ></div>
        </div>

        <!-- Size dropdown -->
        <div
          class="loomhaus-quick-view__option-group"
          data-size-group
          hidden
        >
          <label
            class="loomhaus-quick-view__option-label"
            for="LoomhausQuickSize-{{ section_id }}"
          >
            SIZE
          </label>

          <select
            id="LoomhausQuickSize-{{ section_id }}"
            class="loomhaus-quick-view__select"
            data-size-select
          >
            <option value="">Choose your size</option>
          </select>
        </div>

        <!-- Other product options -->
        <div
          class="loomhaus-quick-view__other-options"
          data-other-options
        ></div>

        <!-- Add to cart -->
        <button
          type="button"
          class="loomhaus-quick-view__add"
          data-quick-add
          disabled
        >
          <span data-quick-add-text>ADD TO CART</span>

          <img
            src="https://cdn.shopify.com/s/files/1/0775/2024/0730/files/arrow-right_ca1fffaa-fb25-4d69-9eaf-cbbbacfe05b0.png?v=1793638060"
            alt=""
            class="loomhaus-quick-view__arrow"
            width="18"
            height="18"
          >
        </button>

        <p
          class="loomhaus-quick-view__message"
          data-quick-message
          aria-live="polite"
        ></p>

      </div>
    </div>
  </div>
</div>
